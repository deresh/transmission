<?xml version="1.0" encoding="UTF-8"?>
<interface domain="transmission-gtk">
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.5"/>
  <object class="AdwDialog" id="OptionsDialog">
    <property name="title" translatable="yes">Torrent Options</property>
    <property name="content-width">540</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <child type="start">
              <object class="GtkButton" id="cancel_button">
                <property name="label" translatable="yes">_Cancel</property>
                <property name="use-underline">1</property>
                <property name="focusable">1</property>
                <property name="receives-default">1</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="open_button">
                <property name="label" translatable="yes">_Open</property>
                <property name="use-underline">1</property>
                <property name="focusable">1</property>
                <property name="receives-default">1</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage">
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Torrent file</property>
                    <child type="suffix">
                      <object class="gtkmm__CustomObject_10PathButton" id="source_button">
                        <property name="title" translatable="yes">Select Source File</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Destination folder</property>
                    <child type="suffix">
                      <object class="GtkLabel" id="free_space_label">
                        <property name="label">...</property>
                        <property name="xalign">0</property>
                        <attributes>
                          <attribute name="style" value="italic"/>
                        </attributes>
                      </object>
                    </child>
                    <child type="suffix">
                      <object class="gtkmm__CustomObject_10PathButton" id="destination_button">
                        <property name="action">select-folder</property>
                        <property name="title" translatable="yes">Select Destination Folder</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Files</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">12</property>
                    <child>
                      <object class="GtkScrolledWindow" id="files_view_scroll">
                        <property name="height-request">300</property>
                        <property name="focusable">1</property>
                        <property name="has-frame">1</property>
                        <property name="css-classes">card</property>
                        <property name="child">
                          <object class="GtkTreeView" id="files_view">
                            <property name="focusable">1</property>
                            <property name="hexpand">1</property>
                            <property name="vexpand">1</property>
                            <child internal-child="selection">
                              <object class="GtkTreeSelection" id="files_view_selection"/>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Options</property>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Torrent priority</property>
                    <child type="suffix">
                      <object class="GtkComboBox" id="priority_combo">
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Start when added</property>
                    <property name="activatable-widget">start_check</property>
                    <child type="prefix">
                      <object class="GtkCheckButton" id="start_check">
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Move torrent file to the trash</property>
                    <property name="activatable-widget">trash_check</property>
                    <child type="prefix">
                      <object class="GtkCheckButton" id="trash_check">
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
