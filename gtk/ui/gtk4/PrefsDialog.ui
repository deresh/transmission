<?xml version='1.0' encoding='UTF-8'?>
<interface domain="transmission-gtk">
  <requires lib="gtk" version="4.0" />
  <object class="AdwPreferencesDialog" id="PrefsDialog">
    <property name="title" translatable="yes">Transmission Preferences</property>
    <child>
      <object class="AdwPreferencesPage" id="speed_page_layout">
        <property name="title" translatable="yes">Speed</property>
        <property name="icon-name">network-transmit-receive-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Speed Limits</property>
            <child>
              <object class="AdwSwitchRow" id="upload_limit_check">
                <property name="title" translatable="yes">Upload ({speed_units})</property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="upload_limit_spin">
                <property name="title" translatable="yes">Upload limit</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="download_limit_check">
                <property name="title" translatable="yes">Download ({speed_units})</property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="download_limit_spin">
                <property name="title" translatable="yes">Download limit</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="description" translatable="yes">Override normal speed limits manually or at scheduled times</property>
            <property name="title" translatable="yes">Alternative Speed Limits</property>
            <child>
              <object class="AdwSpinRow" id="alt_upload_limit_spin">
                <property name="title" translatable="yes">Upload ({speed_units})</property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="alt_download_limit_spin">
                <property name="title" translatable="yes">Download ({speed_units})</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="alt_schedule_time_check">
                <property name="title" translatable="yes">Scheduled times</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="alt_speed_start_time_combo">
                <property name="title" translatable="yes">Start time</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="alt_speed_end_time_combo">
                <property name="title" translatable="yes">End time</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="alt_speed_days_combo">
                <property name="title" translatable="yes">On days</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesPage" id="downloading_page_layout">
        <property name="title" translatable="yes">Downloading</property>
        <property name="icon-name">folder-download-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Adding</property>
            <child>
              <object class="AdwSwitchRow" id="watch_dir_check">
                <property name="title" translatable="yes">Automatically add torrent files from</property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Watch folder</property>
                <child type="suffix">
                  <object class="gtkmm__CustomObject_10PathButton" id="watch_dir_chooser">
                    <property name="sensitive" bind-source="watch_dir_check" bind-property="active" bind-flags="sync-create">0</property>
                    <property name="hexpand">1</property>
                    <property name="action">select-folder</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="show_options_dialog_check">
                <property name="title" translatable="yes">Show the Torrent Options dialog</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="start_on_add_check">
                <property name="title" translatable="yes">Start added torrents</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="trash_on_add_check">
                <property name="title" translatable="yes">Move torrent file to the trash</property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Save to location</property>
                <child type="suffix">
                  <object class="GtkLabel" id="download_dir_stats_label">
                    <property name="label">...</property>
                    <property name="xalign">0</property>
                    <attributes>
                      <attribute name="style" value="italic" />
                    </attributes>
                  </object>
                </child>
                <child type="suffix">
                  <object class="gtkmm__CustomObject_10PathButton" id="download_dir_chooser">
                    <property name="action">select-folder</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Download Queue</property>
            <child>
              <object class="AdwSpinRow" id="max_active_downloads_spin">
                <property name="title" translatable="yes">Maximum active downloads</property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="max_inactive_time_spin">
                <property name="title" translatable="yes">Downloads sharing data in the last N minutes are active</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Incomplete</property>
            <child>
              <object class="AdwSwitchRow" id="append_suffix_to_incomplete_check">
                <property name="title" translatable="yes">Append "._part" to incomplete files' names</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="incomplete_dir_check">
                <property name="title" translatable="yes">Keep incomplete torrents in</property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Incomplete folder</property>
                <child type="suffix">
                  <object class="gtkmm__CustomObject_10PathButton" id="incomplete_dir_chooser">
                    <property name="sensitive" bind-source="incomplete_dir_check" bind-property="active" bind-flags="sync-create">0</property>
                    <property name="hexpand">1</property>
                    <property name="action">select-folder</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="download_done_script_check">
                <property name="title" translatable="yes">Call script when done downloading</property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Script</property>
                <child type="suffix">
                  <object class="gtkmm__CustomObject_10PathButton" id="download_done_script_chooser">
                    <property name="sensitive" bind-source="download_done_script_check" bind-property="active" bind-flags="sync-create">0</property>
                    <property name="hexpand">1</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesPage" id="seeding_page_layout">
        <property name="title" translatable="yes">Seeding</property>
        <property name="icon-name">go-up-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Limits</property>
            <child>
              <object class="AdwSwitchRow" id="stop_seeding_ratio_check">
                <property name="title" translatable="yes">Stop seeding at ratio</property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="stop_seeding_ratio_spin">
                <property name="title" translatable="yes">Ratio</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="stop_seeding_timeout_check">
                <property name="title" translatable="yes">Stop seeding if idle for N minutes</property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="stop_seeding_timeout_spin">
                <property name="title" translatable="yes">Idle time (minutes)</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="seeding_done_script_check">
                <property name="title" translatable="yes">Call script when done seeding</property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Script</property>
                <child type="suffix">
                  <object class="gtkmm__CustomObject_10PathButton" id="seeding_done_script_chooser">
                    <property name="sensitive" bind-source="seeding_done_script_check" bind-property="active" bind-flags="sync-create">0</property>
                    <property name="hexpand">1</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesPage" id="privacy_page_layout">
        <property name="title" translatable="yes">Privacy</property>
        <property name="icon-name">security-high-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Privacy</property>
            <child>
              <object class="AdwComboRow" id="encryption_mode_combo">
                <property name="title" translatable="yes">Encryption mode</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Blocklist</property>
            <child>
              <object class="AdwSwitchRow" id="blocklist_check">
                <property name="title" translatable="yes">Enable blocklist</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="blocklist_autoupdate_check">
                <property name="title" translatable="yes">Enable automatic updates</property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Blocklist URL</property>
                <child type="suffix">
                  <object class="GtkEntry" id="blocklist_url_entry">
                    <property name="sensitive" bind-source="blocklist_check" bind-property="active" bind-flags="sync-create">0</property>
                    <property name="width-request">300</property>
                    <property name="focusable">1</property>
                    <property name="hexpand">1</property>
                    <property name="hexpand">1</property>
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="blocklist_stats_label">
                <property name="sensitive" bind-source="blocklist_check" bind-property="active" bind-flags="sync-create">0</property>
                <property name="hexpand">1</property>
                <property name="label">...</property>
                <property name="xalign">0</property>
                <attributes>
                  <attribute name="style" value="italic" />
                </attributes>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Update blocklist</property>
                <child type="suffix">
                  <object class="GtkButton" id="update_blocklist_button">
                    <property name="label" translatable="yes">_Update</property>
                    <property name="focusable">1</property>
                    <property name="receives-default">1</property>
                    <property name="use-underline">1</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesPage" id="network_page_layout">
        <property name="title" translatable="yes">Network</property>
        <property name="icon-name">network-wired-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Listening Port</property>
            <child>
              <object class="AdwSwitchRow" id="pick_random_listening_port_at_start_check">
                <property name="title" translatable="yes">Pick a random port every time Transmission is started</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="enable_listening_port_forwarding_check">
                <property name="title" translatable="yes">Use UPnP or NAT-PMP port forwarding from my router</property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Port status</property>
                <child type="suffix">
                  <object class="GtkLabel" id="listening_port_status_label">
                    <property name="hexpand">1</property>
                    <property name="label">...</property>
                    <property name="xalign">0</property>
                    <attributes>
                      <attribute name="style" value="italic" />
                    </attributes>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="listening_port_spin">
                <property name="title" translatable="yes">Port used for incoming connections</property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Test port</property>
                <child type="suffix">
                  <object class="GtkButton" id="test_listening_port_button">
                    <property name="label" translatable="yes">Te_st Port</property>
                    <property name="focusable">1</property>
                    <property name="receives-default">1</property>
                    <property name="use-underline">1</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Peer Limits</property>
            <child>
              <object class="AdwSpinRow" id="max_torrent_peers_spin">
                <property name="title" translatable="yes">Maximum peers per torrent</property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="max_total_peers_spin">
                <property name="title" translatable="yes">Maximum peers overall</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Options</property>
            <child>
              <object class="AdwSwitchRow" id="enable_utp_check">
                <property name="title" translatable="yes">Enable µTP for peer communication</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="enable_pex_check">
                <property name="title" translatable="yes">Use PEX to find more peers</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="enable_dht_check">
                <property name="title" translatable="yes">Use DHT to find more peers</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="enable_lpd_check">
                <property name="title" translatable="yes">Use Local Peer Discovery to find more peers</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Default Public Trackers</property>
            <child>
              <object class="GtkScrolledWindow" id="default_trackers_scroll">
                <property name="height-request">90</property>
                <property name="focusable">1</property>
                <property name="hexpand">1</property>
                <property name="vexpand">1</property>
                <property name="has-frame">1</property>
                <property name="child">
                  <object class="GtkTextView" id="default_trackers_view">
                    <property name="focusable">1</property>
                    <property name="accepts-tab">0</property>
                    <property name="tooltip-text" translatable="yes">Trackers to use on all public torrents.

To add a backup URL, add it on the next line after a primary URL.
To add a new primary URL, add it after a blank line.</property>
                    <property name="vexpand">1</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesPage" id="desktop_page_layout">
        <property name="title" translatable="yes">Desktop</property>
        <property name="icon-name">computer-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Desktop</property>
            <child>
              <object class="AdwSwitchRow" id="inhibit_hibernation_check">
                <property name="title" translatable="yes">Inhibit hibernation when torrents are active</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="show_systray_icon_check">
                <property name="title" translatable="yes">Show Transmission icon in the notification area</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Notification</property>
            <child>
              <object class="AdwSwitchRow" id="notify_on_torrent_add_check">
                <property name="title" translatable="yes">Show a notification when torrents are added</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="notify_on_torrent_finish_check">
                <property name="title" translatable="yes">Show a notification when torrents finish</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="ding_no_torrent_finish_check">
                <property name="title" translatable="yes">Play a sound when torrents finish</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesPage" id="remote_page_layout">
        <property name="title" translatable="yes">Remote</property>
        <property name="icon-name">network-server-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Remote Control</property>
            <child>
              <object class="AdwSwitchRow" id="enable_rpc_check">
                <property name="title" translatable="yes">Allow remote access</property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow" id="web_client_row">
                <property name="title" translatable="yes">Web client</property>
                <child type="suffix">
                  <object class="GtkButton" id="open_web_client_button">
                    <property name="sensitive" bind-source="enable_rpc_check" bind-property="active" bind-flags="sync-create">0</property>
                    <property name="label" translatable="yes">_Open web client</property>
                    <property name="focusable">1</property>
                    <property name="receives-default">1</property>
                    <property name="use-underline">1</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="rpc_port_spin">
                <property name="title" translatable="yes">HTTP port</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="enable_rpc_auth_check">
                <property name="title" translatable="yes">Use authentication</property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow" id="rpc_username_row">
                <property name="title" translatable="yes">Username</property>
                <child type="suffix">
                  <object class="GtkEntry" id="rpc_username_entry">
                    <property name="focusable">1</property>
                    <property name="hexpand">1</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwActionRow" id="rpc_password_row">
                <property name="title" translatable="yes">Password</property>
                <child type="suffix">
                  <object class="GtkEntry" id="rpc_password_entry">
                    <property name="focusable">1</property>
                    <property name="hexpand">1</property>
                    <property name="visibility">0</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="rpc_whitelist_check">
                <property name="title" translatable="yes">Only allow these IP addresses</property>
              </object>
            </child>
            <child>
              <object class="AdwEntryRow" id="rpc_whitelist_entry">
                <property name="title" translatable="yes">IP address (wildcards like 192.168.*.*)</property>
                <child type="suffix">
                  <object class="GtkButton" id="add_to_rpc_whitelist_button">
                    <property name="label" translatable="yes">_Add</property>
                    <property name="focusable">1</property>
                    <property name="receives-default">1</property>
                    <property name="use-underline">1</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkListBox" id="rpc_whitelist_list">
                <property name="selection-mode">none</property>
                <property name="css-classes">boxed-list</property>
                <property name="margin-top">12</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkSizeGroup" id="downloading_page_labels_width_group">
    <widgets>
      <widget name="watch_dir_check" />
      <widget name="incomplete_dir_check" />
      <widget name="download_done_script_check" />
    </widgets>
  </object>
  <object class="GtkSizeGroup" id="network_page_labels_width_group">
    <widgets>
      </widgets>
  </object>
  <object class="GtkSizeGroup" id="privacy_page_labels_width_group">
    <widgets>
      <widget name="blocklist_check" />
    </widgets>
  </object>
  <object class="GtkSizeGroup" id="speed_page_labels_width_group">
    <widgets>
      <widget name="upload_limit_check" />
      <widget name="download_limit_check" />
      <widget name="alt_schedule_time_check" />
    </widgets>
  </object>
</interface>