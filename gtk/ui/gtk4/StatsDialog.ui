<?xml version="1.0" encoding="UTF-8"?>
<interface domain="transmission-gtk">
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.5"/>
  <object class="AdwDialog" id="StatsDialog">
    <property name="title" translatable="yes">Statistics</property>
    <property name="content-width">420</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <child type="start">
              <object class="GtkButton" id="reset_button">
                <property name="label" translatable="yes">_Reset</property>
                <property name="use-underline">1</property>
                <property name="focusable">1</property>
                <property name="receives-default">1</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="close_button">
                <property name="label" translatable="yes">_Close</property>
                <property name="use-underline">1</property>
                <property name="focusable">1</property>
                <property name="receives-default">1</property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage">
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Current Session</property>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Uploaded</property>
                    <child type="suffix">
                      <object class="GtkLabel" id="current_uploaded_value_label">
                        <property name="label">...</property>
                        <property name="selectable">1</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Downloaded</property>
                    <child type="suffix">
                      <object class="GtkLabel" id="current_downloaded_value_label">
                        <property name="label">...</property>
                        <property name="selectable">1</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Ratio</property>
                    <child type="suffix">
                      <object class="GtkLabel" id="current_ratio_value_label">
                        <property name="label">...</property>
                        <property name="selectable">1</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Duration</property>
                    <child type="suffix">
                      <object class="GtkLabel" id="current_duration_value_label">
                        <property name="label">...</property>
                        <property name="selectable">1</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Total</property>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Sessions</property>
                    <child type="suffix">
                      <object class="GtkLabel" id="start_count_label">
                        <property name="label">...</property>
                        <property name="selectable">1</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Uploaded</property>
                    <child type="suffix">
                      <object class="GtkLabel" id="total_uploaded_value_label">
                        <property name="label">...</property>
                        <property name="selectable">1</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Downloaded</property>
                    <child type="suffix">
                      <object class="GtkLabel" id="total_downloaded_value_label">
                        <property name="label">...</property>
                        <property name="selectable">1</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Ratio</property>
                    <child type="suffix">
                      <object class="GtkLabel" id="total_ratio_value_label">
                        <property name="label">...</property>
                        <property name="selectable">1</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Duration</property>
                    <child type="suffix">
                      <object class="GtkLabel" id="total_duration_value_label">
                        <property name="label">...</property>
                        <property name="selectable">1</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
